#? ============================================
#? BASE DE DATOS (PostgreSQL)
#? ============================================
# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.xxdurtxmryhakidpvczy:WiseEtereo471@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.xxdurtxmryhakidpvczy:WiseEtereo471@aws-0-us-west-1.pooler.supabase.com:5432/postgres"


#?============================================
#? SERVIDOR
#? ============================================
# Puerto donde corre el servidor
PORT=3000
# URL del frontend para CORS (en desarrollo usar http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

#? ============================================
#? JWT (JSON Web Tokens)
#? ============================================
#! Secret para firmar los access tokens (cambiar en producción)
JWT_SECRET="R5khZJ9I0p69u7OrCct6BlzKnMrwJyENlovdsM4f7O"
#! Secret para firmar los refresh tokens (cambiar en producción)
JWT_REFRESH_SECRET="R5khZJ9I0p69u7OrCct6BlzKnMrwJyENlovdsM4f7Okeyinproduction2025"

#? ============================================
#? RATE LIMITING (Límite de peticiones)
#? ============================================
# Tiempo en segundos para el límite de peticiones
THROTTLE_TTL=60

# Número máximo de peticiones en el período TTL
THROTTLE_LIMIT=60

# Tiempo de expiración del access token (15 minutos)
ACCESS_TOKEN_TTL=15m

# Tiempo de expiración del refresh token (7 días)
REFRESH_TOKEN_TTL=7d


#? ============================================
#? EMAIL (Configuración para envío de invitaciones)
#? ============================================
# Proveedor de email (gmail, outlook, sendgrid, etc.)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="tu-email@gmail.com"
EMAIL_PASSWORD="tu-app-password"
EMAIL_FROM="XHION Core <noreply@xhion.com>"

#? ============================================
#? SEED (Datos iniciales)
#? ============================================
# Email del usuario administrador inicial
SEED_ADMIN_EMAIL="admin@xhion.com"

# Contraseña del usuario administrador inicial
SEED_ADMIN_PASSWORD="Admin12345!"


#! FALTA IMPLEMENTAR
#? ============================================
#? SEGURIDAD
#? ============================================
# Número máximo de intentos de login antes de bloquear
MAX_LOGIN_ATTEMPTS=5

# Tiempo de bloqueo después de exceder intentos (en minutos)
LOCKOUT_DURATION=15


#! FALTA IMPLEMENTAR
#? ============================================
#? LOGS
#? ============================================
# Nivel de logs (error, warn, info, debug, verbose)
LOG_LEVEL="debug"

#! FALTA IMPLEMENTAR
#? ============================================
#? GEMINI API (Inteligencia Artificial)
#? ============================================
# API Key de Google Gemini (opcional, para funciones de IA)
GEMINI_API_KEY=""

#! FALTA IMPLEMENTAR
#? ============================================
#? STORAGE (Almacenamiento de archivos)
#? ============================================
# Directorio para almacenar archivos subidos
UPLOAD_DIR="./uploads"

# Tamaño máximo de archivo en MB
MAX_FILE_SIZE=10

#! FALTA IMPLEMENTAR
#? ============================================
#? REDIS (Opcional, para caché y sesiones)
#? ============================================
# URL de conexión a Redis (opcional)
# REDIS_URL="redis://localhost:6379"

#! FALTA IMPLEMENTAR
