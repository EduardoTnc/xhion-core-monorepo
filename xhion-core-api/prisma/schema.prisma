/// Invitaciones para nuevos usuarios.
model Invitacion {
  id                String    @id @default(uuid()) @db.Uuid
  nombre_completo   String    @default("Desconocido") @db.VarChar(100)
  email             String    @db.VarChar(100)
  rol_id            String    @map("rol_id") @db.Uuid
  departamento_id   String?   @map("departamento_id") @db.Uuid // Opcional si un invitado no tiene depto al inicio
  token             String    @unique @db.VarChar(255)
  fecha_expiracion  DateTime
  fue_utilizada     Boolean   @default(false)
  fecha_utilizacion DateTime? // Fecha en que se aceptó la invitación

  invitado_por_id String  @map("invitado_por_id") @db.Uuid
  invitado_por    Usuario @relation("InvitadoPor", fields: [invitado_por_id], references: [id])

  fecha_creacion DateTime @default(now())

  rol             Rol              @relation(fields: [rol_id], references: [id])
  departamento    Departamento?    @relation(fields: [departamento_id], references: [id])
  solicitudAcceso SolicitudAcceso? @relation("SolicitudInvitacion")

  @@map("invitaciones")
}

/// Permite almacenar múltiples datos de contacto por usuario.
model UsuarioContacto {
  id        String       @id @default(uuid()) @db.Uuid
  usuarioId String       @db.Uuid
  tipo      TipoContacto
  valor     String       @db.VarChar(255)
  esPrivado Boolean      @default(true)

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

/// Permite almacenar múltiples enlaces profesionales por usuario.
model UsuarioEnlaceProfesional {
  id        String                @id @default(uuid()) @db.Uuid
  usuarioId String                @db.Uuid
  tipo      TipoEnlaceProfesional
  url       String

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

/// Catálogo centralizado de habilidades y competencias.
model Habilidad {
  id        String              @id @default(uuid()) @db.Uuid
  nombre    String              @unique @db.VarChar(100)
  categoria CategoriaHabilidad?

  usuarios UsuarioHabilidad[]
}

/// Tabla pivote para asignar habilidades a los usuarios.
model UsuarioHabilidad {
  usuarioId     String          @db.Uuid
  habilidadId   String          @db.Uuid
  nivel         NivelHabilidad?
  sugeridoPorIa Boolean         @default(false)

  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  habilidad Habilidad @relation(fields: [habilidadId], references: [id])

  @@id([usuarioId, habilidadId])
