// Le dice a Prisma qué debe generar y dónde.
generator client {
  provider = "prisma-client"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

/// Gestión de sesiones y refresh tokens de usuarios.
model Sesion {
  id               String   @id @default(uuid()) @db.Uuid
  usuarioId        String   @db.Uuid
  refreshTokenHash String   @unique @db.VarChar(255)
  accessToken      String?  @unique @db.VarChar(500) // Token de acceso para identificar sesión actual
  userAgent        String?  @map("user_agent")
  direccionIp      String?  @map("direccion_ip") @db.VarChar(45)
  fechaCreacion    DateTime @default(now())
  fechaUltimoUso   DateTime @updatedAt
  fechaExpiracion  DateTime @default(dbgenerated("NOW() + INTERVAL '7 days'")) // Fecha de expiración del refresh token (7 días por defecto)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([fechaExpiracion])
  @@map("sesiones")
}

