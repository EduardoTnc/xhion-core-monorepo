/// Documentos asociados a proyectos (resúmenes, objetivos, etc.).
model DocumentoProyecto {
  id                 String                @id @default(uuid()) @db.Uuid
  proyectoId         String                @db.Uuid
  tipo               TipoDocumentoProyecto
  titulo             String                @db.VarChar(255)
  contenido          String
  archivoId          String?               @db.Uuid
  fechaCreacion      DateTime              @default(now())
  fechaActualizacion DateTime              @updatedAt
  creadoPorId        String                @db.Uuid

  proyecto  Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  archivo   Archivo? @relation(fields: [archivoId], references: [id])
  creadoPor Usuario  @relation(fields: [creadoPorId], references: [id])

  @@index([proyectoId])
  @@index([tipo])
}

/// Documentos asociados a departamentos (resúmenes, objetivos, etc.).
model DocumentoDepartamento {
  id                 String                    @id @default(uuid()) @db.Uuid
  departamentoId     String                    @db.Uuid
  tipo               TipoDocumentoDepartamento
  titulo             String                    @db.VarChar(255)
  contenido          String
  fechaCreacion      DateTime                  @default(now())
  fechaActualizacion DateTime                  @updatedAt
  creadoPorId        String                    @db.Uuid

  departamento Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  creadoPor    Usuario      @relation(fields: [creadoPorId], references: [id])

  @@index([departamentoId])
  @@index([tipo])
}

// --- MODULO: SEGURIDAD Y AUDITORIA ---

/// Catálogo de todas las acciones posibles en el sistema.
model Permiso {
  id           String  @id @default(uuid()) @db.Uuid
  nombreAccion String  @unique @db.VarChar(100)
  descripcion  String?

  roles RolPermiso[]
}

/// Asigna permisos específicos a cada rol (RBAC).
model RolPermiso {
  rolId     String @db.Uuid
  permisoId String @db.Uuid

  rol     Rol     @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
}

/// Registro inmutable de todas las acciones importantes.
model RegistroAuditoria {
  id          String   @id @default(uuid()) @db.Uuid
  usuarioId   String?  @db.Uuid
  accion      String   @db.VarChar(255)
  detalles    Json?
  direccionIp String?  @db.VarChar(45)
  timestamp   DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])
}

// --- MODULO: GESTION DE PRESUPUESTOS (SPRINT 2) ---

enum TipoMovimientoPresupuesto {
  Asignacion
  Gasto
  Ajuste
  Transferencia
}

enum EstadoPresupuesto {
  Activo
  Agotado
  Cerrado
  Suspendido
}

/// Presupuesto asignado a un departamento.
model PresupuestoDepartamento {
  id                 String            @id @default(uuid()) @db.Uuid
  departamentoId     String            @unique @db.Uuid
  montoTotal         Decimal           @db.Decimal(15, 2)
  montoGastado       Decimal           @default(0) @db.Decimal(15, 2)
  montoDisponible    Decimal           @db.Decimal(15, 2)
  periodo            String            @db.VarChar(50) // Ej: "2025-Q1", "2025", "Enero 2025"
  fechaInicio        DateTime
  fechaFin           DateTime
  estado             EstadoPresupuesto @default(Activo)
  descripcion        String?
  fechaCreacion      DateTime          @default(now())
  fechaActualizacion DateTime          @updatedAt
  creadoPorId        String            @db.Uuid

  departamento Departamento                        @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  creadoPor    Usuario                             @relation("PresupuestosDepartamentoCreados", fields: [creadoPorId], references: [id])
  movimientos  MovimientoPresupuestoDepartamento[]

  @@index([departamentoId, periodo])
  @@index([estado])
}

/// Movimientos del presupuesto de un departamento.
model MovimientoPresupuestoDepartamento {
  id                        String                    @id @default(uuid()) @db.Uuid
  presupuestoDepartamentoId String                    @db.Uuid
  tipo                      TipoMovimientoPresupuesto
  monto                     Decimal                   @db.Decimal(15, 2)
  descripcion               String
  categoria                 String?                   @db.VarChar(100) // Ej: "Salarios", "Equipamiento", "Marketing"
  comprobante               String? // URL o referencia al comprobante
  archivoId                 String?                   @db.Uuid
  fechaMovimiento           DateTime                  @default(now())
  registradoPorId           String                    @db.Uuid

  presupuestoDepartamento PresupuestoDepartamento @relation(fields: [presupuestoDepartamentoId], references: [id], onDelete: Cascade)
  archivo                 Archivo?                @relation("ComprobanteMovimientoDepartamento", fields: [archivoId], references: [id])
  registradoPor           Usuario                 @relation("MovimientosPresupuestoDepartamento", fields: [registradoPorId], references: [id])

  @@index([presupuestoDepartamentoId])
  @@index([tipo])
  @@index([fechaMovimiento])
}

/// Presupuesto asignado a un proyecto.
model PresupuestoProyecto {
  id                 String            @id @default(uuid()) @db.Uuid
  proyectoId         String            @unique @db.Uuid
  montoTotal         Decimal           @db.Decimal(15, 2)
  montoGastado       Decimal           @default(0) @db.Decimal(15, 2)
  montoDisponible    Decimal           @db.Decimal(15, 2)
  estado             EstadoPresupuesto @default(Activo)
  descripcion        String?
  fechaCreacion      DateTime          @default(now())
  fechaActualizacion DateTime          @updatedAt
  creadoPorId        String            @db.Uuid

  proyecto    Proyecto                        @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  creadoPor   Usuario                         @relation("PresupuestosProyectoCreados", fields: [creadoPorId], references: [id])
  movimientos MovimientoPresupuestoProyecto[]

  @@index([proyectoId])
  @@index([estado])
}

/// Movimientos del presupuesto de un proyecto.
model MovimientoPresupuestoProyecto {
  id                    String                    @id @default(uuid()) @db.Uuid
  presupuestoProyectoId String                    @db.Uuid
  tipo                  TipoMovimientoPresupuesto
  monto                 Decimal                   @db.Decimal(15, 2)
  descripcion           String
  categoria             String?                   @db.VarChar(100) // Ej: "Desarrollo", "Infraestructura", "Licencias"
  comprobante           String? // URL o referencia al comprobante
  archivoId             String?                   @db.Uuid
  fechaMovimiento       DateTime                  @default(now())
  registradoPorId       String                    @db.Uuid

  presupuestoProyecto PresupuestoProyecto @relation(fields: [presupuestoProyectoId], references: [id], onDelete: Cascade)
  archivo             Archivo?            @relation("ComprobanteMovimientoProyecto", fields: [archivoId], references: [id])
  registradoPor       Usuario             @relation("MovimientosPresupuestoProyecto", fields: [registradoPorId], references: [id])

  @@index([presupuestoProyectoId])
  @@index([tipo])
  @@index([fechaMovimiento])
}

// --- SISTEMA DE IDEAS ---

enum CategoriaIdea {
  Feature // Nueva funcionalidad
  Improvement // Mejora
  Innovation // Innovación
  Recommendation // Recomendación
}

enum EstadoIdea {
  Evaluating // En evaluación
  Approved // Aprobada
  InDevelopment // En desarrollo
  Implemented // Implementada
  Rejected // Rechazada
}

/// Ideas del buzón de sugerencias con análisis de IA
model Idea {
  id                 String        @id @default(uuid()) @db.Uuid
  titulo             String        @db.VarChar(200)
  descripcion        String
  categoria          CategoriaIdea
  estado             EstadoIdea    @default(Evaluating)
  autorId            String        @db.Uuid
  aiScore            Int? // Score de IA (0-100)
  aiInsight          String? // Insight generado por IA
  tags               String[] // Array de tags
  fechaCreacion      DateTime      @default(now())
  fechaActualizacion DateTime      @updatedAt

  autor       Usuario          @relation("IdeasCreadas", fields: [autorId], references: [id], onDelete: Cascade)
  votos       VotoIdea[]
  comentarios ComentarioIdea[]

  @@index([autorId])
  @@index([categoria])
  @@index([estado])
  @@index([fechaCreacion])
}

/// Votos de usuarios en ideas
model VotoIdea {
  id        String   @id @default(uuid()) @db.Uuid
  ideaId    String   @db.Uuid
  usuarioId String   @db.Uuid
  fechaVoto DateTime @default(now())

  idea    Idea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation("VotosIdeas", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([ideaId, usuarioId]) // Un usuario solo puede votar una vez por idea
  @@index([ideaId])
  @@index([usuarioId])
}

/// Comentarios en ideas
model ComentarioIdea {
  id                 String   @id @default(uuid()) @db.Uuid
  ideaId             String   @db.Uuid
  usuarioId          String   @db.Uuid
  contenido          String
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  idea    Idea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation("ComentariosIdeas", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([usuarioId])
  @@index([fechaCreacion])
}

// --- MODULO: CALENDARIO Y EVENTOS (SPRINT 8) ---

enum TipoEvento {
  Reunion
  Tarea
  Proyecto
  Personal
  Recordatorio
}

enum EstadoEvento {
  Pendiente
  En_Curso
  Completado
  Cancelado
}

/// Eventos del calendario (reuniones, tareas con fecha, eventos personales)
model Evento {
  id          String       @id @default(uuid()) @db.Uuid
  titulo      String       @db.VarChar(200)
  descripcion String?
  tipo        TipoEvento
  estado      EstadoEvento @default(Pendiente)
  fechaInicio DateTime
  fechaFin    DateTime
  todoElDia   Boolean      @default(false)
  ubicacion   String?      @db.VarChar(300)
  color       String?      @db.VarChar(20) // Código de color hex

  // Relaciones opcionales
  proyectoId String? @db.Uuid
  tareaId    String? @db.Uuid

  // Creador del evento
  creadorId String @db.Uuid

  // Auditoría
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
  eliminado          Boolean  @default(false)

  // Relaciones
  creador        Usuario              @relation("EventosCreados", fields: [creadorId], references: [id], onDelete: Cascade)
  proyecto       Proyecto?            @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tarea          Tarea?               @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  participantes  EventoParticipante[]
  notificaciones Notificacion[]

  @@index([creadorId])
  @@index([proyectoId])
  @@index([tareaId])
  @@index([tipo])
  @@index([estado])
  @@index([fechaInicio])
  @@index([fechaFin])
  @@map("eventos")
}

/// Participantes de eventos
model EventoParticipante {
  id             String    @id @default(uuid()) @db.Uuid
  eventoId       String    @db.Uuid
  usuarioId      String    @db.Uuid
  confirmado     Boolean   @default(false)
  fechaRespuesta DateTime?

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation("EventosParticipando", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([eventoId, usuarioId])
  @@index([eventoId])
  @@index([usuarioId])
  @@map("evento_participantes")
}

// --- MODULO: NOTIFICACIONES (SPRINT 8) ---

enum TipoNotificacion {
  Sistema
  Tarea
  Proyecto
  Evento
  Mensaje
  Mencion
  Comentario
  Recordatorio
}

enum EstadoNotificacion {
  NoLeida
  Leida
  Archivada
}

/// Notificaciones del sistema
model Notificacion {
  id      String             @id @default(uuid()) @db.Uuid
  titulo  String             @db.VarChar(200)
  mensaje String
  tipo    TipoNotificacion
  estado  EstadoNotificacion @default(NoLeida)

  // Destinatario
  usuarioId String @db.Uuid

  // Relaciones opcionales (origen de la notificación)
  proyectoId String? @db.Uuid
  tareaId    String? @db.Uuid
  eventoId   String? @db.Uuid

  // Metadata
  metadata Json? // Datos adicionales en formato JSON
  url      String? @db.VarChar(500) // URL de acción

  // Auditoría
  fechaCreacion  DateTime  @default(now())
  fechaLeida     DateTime?
  fechaArchivada DateTime?

  // Relaciones
  usuario  Usuario   @relation("NotificacionesRecibidas", fields: [usuarioId], references: [id], onDelete: Cascade)
  proyecto Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tarea    Tarea?    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  evento   Evento?   @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([proyectoId])
  @@index([tareaId])
  @@index([eventoId])
  @@index([tipo])
  @@index([estado])
  @@index([fechaCreacion])
  @@map("notificaciones")
}

// --- MODULO: SOLICITUDES DE ACCESO ---

enum EstadoSolicitud {
  Pendiente
  Aprobada
  Rechazada
  Expirada
}

/// Solicitudes de acceso al sistema de usuarios externos
model SolicitudAcceso {
  id             String          @id @default(uuid()) @db.Uuid
  nombreCompleto String          @db.VarChar(200)
  email          String          @db.VarChar(255)
  telefono       String?         @db.VarChar(20)
  empresa        String?         @db.VarChar(200)
  cargo          String?         @db.VarChar(100)
  mensaje        String? // Mensaje opcional del solicitante
  estado         EstadoSolicitud @default(Pendiente)

  // Información de procesamiento
  revisadoPorId      String?   @db.Uuid
  fechaRevision      DateTime?
  comentarioRevision String? // Comentario del revisor
  invitacionId       String?   @unique @db.Uuid // Si se aprueba, se crea una invitación

  // Auditoría
  fechaCreacion   DateTime @default(now())
  fechaExpiracion DateTime // Las solicitudes expiran después de 30 días
  ipSolicitud     String?  @db.VarChar(45) // IPv4 o IPv6

  // Relaciones
  revisadoPor Usuario?    @relation("SolicitudesRevisadas", fields: [revisadoPorId], references: [id])
  invitacion  Invitacion? @relation("SolicitudInvitacion", fields: [invitacionId], references: [id])

  @@index([email])
  @@index([estado])
  @@index([fechaCreacion])
  @@index([fechaExpiracion])
  @@map("solicitudes_acceso")
}

// ============================================
// MODULO: RECURSOS E INVENTARIO
// ============================================

enum TipoRecurso {
  Software
  Hardware
  Material
  Espacio
  Humano
  Otro
}

enum EstadoRecurso {
  Disponible
  Asignado
  En_Mantenimiento
  Fuera_De_Servicio
  Agotado
}

enum UnidadMedida {
  Unidad
  Licencia
  Metro
  Kilogramo
  Hora
  Mes
}

enum TipoMovimiento {
  Entrada
  Salida
  Asignacion
  Devolucion
  Ajuste
  Baja
}

/// Catálogo de recursos de la empresa
model Recurso {
  id                 String        @id @default(uuid()) @db.Uuid
  nombre             String        @db.VarChar(200)
  descripcion        String?
  tipo               TipoRecurso
  categoria          String?       @db.VarChar(100)
  unidadMedida       UnidadMedida
  costoUnitario      Decimal?      @db.Decimal(10, 2)
  stockActual        Int           @default(0)
  stockMinimo        Int?
  estado             EstadoRecurso @default(Disponible)
  proveedor          String?       @db.VarChar(200)
  numeroSerie        String?       @db.VarChar(100)
  fechaAdquisicion   DateTime?     @db.Date
  vidaUtilMeses      Int?
  ubicacionFisica    String?       @db.VarChar(200)
  creadoPorId        String        @db.Uuid
  fechaCreacion      DateTime      @default(now())
  fechaActualizacion DateTime      @updatedAt
  eliminado          Boolean       @default(false)

  creador      Usuario             @relation("RecursosCreados", fields: [creadoPorId], references: [id])
  asignaciones AsignacionRecurso[]
  movimientos  MovimientoRecurso[]
  gastos       GastoProyecto[]

  @@index([tipo])
  @@index([estado])
  @@index([categoria])
  @@map("recursos")
}

/// Asignación de recursos a departamentos o proyectos
model AsignacionRecurso {
  id              String    @id @default(uuid()) @db.Uuid
  recursoId       String    @db.Uuid
  cantidad        Int
  departamentoId  String?   @db.Uuid
  proyectoId      String?   @db.Uuid
  fechaInicio     DateTime  @db.Date
  fechaFin        DateTime? @db.Date
  activa          Boolean   @default(true)
  proposito       String?
  observaciones   String?
  asignadoPorId   String    @db.Uuid
  fechaAsignacion DateTime  @default(now())

  recurso      Recurso       @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  departamento Departamento? @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  proyecto     Proyecto?     @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  asignadoPor  Usuario       @relation("AsignacionesRecursos", fields: [asignadoPorId], references: [id])

  @@index([recursoId])
  @@index([departamentoId])
  @@index([proyectoId])
  @@index([activa])
  @@map("asignaciones_recursos")
}

/// Historial de movimientos de inventario
model MovimientoRecurso {
  id                  String         @id @default(uuid()) @db.Uuid
  recursoId           String         @db.Uuid
  tipo                TipoMovimiento
  cantidad            Int
  stockAnterior       Int
  stockNuevo          Int
  departamentoId      String?        @db.Uuid
  proyectoId          String?        @db.Uuid
  motivo              String?
  costoTotal          Decimal?       @db.Decimal(10, 2)
  documentoReferencia String?        @db.VarChar(100)
  registradoPorId     String         @db.Uuid
  fechaMovimiento     DateTime       @default(now())

  recurso       Recurso       @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  departamento  Departamento? @relation(fields: [departamentoId], references: [id])
  proyecto      Proyecto?     @relation(fields: [proyectoId], references: [id])
  registradoPor Usuario       @relation("MovimientosRecursos", fields: [registradoPorId], references: [id])

  @@index([recursoId])
  @@index([tipo])
  @@index([fechaMovimiento])
  @@map("movimientos_recursos")
}

// ============================================
// MODULO: FINANZAS MEJORADO
// ============================================

enum FuenteIngreso {
  Ventas
  Servicios
  Publicidad
  Suscripciones
  Licencias
  Otro
}

enum CategoriaGasto {
  Personal
  Software
  Hardware
  Materiales
  Servicios
  Marketing
  Infraestructura
  Otro
}

/// Ingresos de proyectos
model IngresoProyecto {
  id              String        @id @default(uuid()) @db.Uuid
  proyectoId      String        @db.Uuid
  fuente          FuenteIngreso
  monto           Decimal       @db.Decimal(10, 2)
  descripcion     String?
  fechaIngreso    DateTime      @db.Date
  comprobante     String?       @db.VarChar(100)
  registradoPorId String        @db.Uuid
  fechaRegistro   DateTime      @default(now())

  proyecto      Proyecto @relation("IngresosProyecto", fields: [proyectoId], references: [id], onDelete: Cascade)
  registradoPor Usuario  @relation("IngresosRegistrados", fields: [registradoPorId], references: [id])

  @@index([proyectoId])
  @@index([fechaIngreso])
  @@map("ingresos_proyectos")
}

/// Gastos de proyectos
model GastoProyecto {
  id              String         @id @default(uuid()) @db.Uuid
  proyectoId      String         @db.Uuid
  categoria       CategoriaGasto
  concepto        String         @db.VarChar(200)
  monto           Decimal        @db.Decimal(10, 2)
  fechaGasto      DateTime       @db.Date
  comprobante     String?        @db.VarChar(100)
  recursoId       String?        @db.Uuid
  registradoPorId String         @db.Uuid
  fechaRegistro   DateTime       @default(now())

  proyecto      Proyecto @relation("GastosProyecto", fields: [proyectoId], references: [id], onDelete: Cascade)
  recurso       Recurso? @relation(fields: [recursoId], references: [id])
  registradoPor Usuario  @relation("GastosRegistrados", fields: [registradoPorId], references: [id])

  @@index([proyectoId])
  @@index([categoria])
  @@index([fechaGasto])
  @@map("gastos_proyectos")
}
