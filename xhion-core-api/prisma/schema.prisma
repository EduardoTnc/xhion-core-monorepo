  contextosDepartamento              ContextoDepartamento[]
  documentosProyecto                 DocumentoProyecto[]
  documentosDepartamento             DocumentoDepartamento[]
  presupuestosDepartamentoCreados    PresupuestoDepartamento[]           @relation("PresupuestosDepartamentoCreados")
  presupuestosProyectoCreados        PresupuestoProyecto[]               @relation("PresupuestosProyectoCreados")
  movimientosPresupuestoDepartamento MovimientoPresupuestoDepartamento[] @relation("MovimientosPresupuestoDepartamento")
  movimientosPresupuestoProyecto     MovimientoPresupuestoProyecto[]     @relation("MovimientosPresupuestoProyecto")
  ideasCreadas                       Idea[]                              @relation("IdeasCreadas")
  votosIdeas                         VotoIdea[]                          @relation("VotosIdeas")
  comentariosIdeas                   ComentarioIdea[]                    @relation("ComentariosIdeas")
  eventosCreados                     Evento[]                            @relation("EventosCreados")
