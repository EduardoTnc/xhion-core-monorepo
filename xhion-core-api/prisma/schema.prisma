// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Le dice a Prisma qué debe generar y dónde.
generator client {
  provider        = "prisma-client-js"
}

/// Gestión de sesiones y refresh tokens de usuarios.
model Sesion {
  id               String    @id @default(uuid()) @db.Uuid
  usuarioId        String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(255)
  userAgent        String?   @map("user_agent")
  direccionIp      String?   @map("direccion_ip") @db.VarChar(45)
  fechaCreacion    DateTime  @default(now())
  fechaUltimoUso   DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sesiones")
}

// Configura la conexión a tu base de datos.
datasource db {
  provider  = "postgresql" // El "dialecto" de la BBDD (puede ser mysql, sqlite, etc.)
  url       = env("DATABASE_URL") // Lee la URL desde las variables de entorno
  directUrl = env("DIRECT_URL") // para migraciones en entornos con pooling
}

