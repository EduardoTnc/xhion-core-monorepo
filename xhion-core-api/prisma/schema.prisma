/// Almacena los departamentos de la empresa.
model Departamento {
  id               String    @id @default(uuid()) @db.Uuid
  nombre           String    @unique @db.VarChar(100)
  descripcion      String?
  objetivos        String? // Objetivos del departamento
  icono            String?   @db.VarChar(50) // Nombre del icono de lucide-react
  color            String?   @db.VarChar(50)
  jefeId           String?   @db.Uuid
  fechaCreacion    DateTime  @default(now())
  fechaEliminacion DateTime? // Para eliminación lógica.

  jefe                 Usuario?                 @relation("JefeDepartamento", fields: [jefeId], references: [id])
  puestosTrabajo       PuestoTrabajo[]
  proyectos            Proyecto[]
  invitaciones         Invitacion[]
  contextoDepartamento ContextoDepartamento?
  presupuesto          PresupuestoDepartamento?
  documentos           DocumentoDepartamento[]
  asignacionesRecursos AsignacionRecurso[]
  movimientosRecursos  MovimientoRecurso[]
}

/// Catálogo centralizado de puestos de trabajo.
