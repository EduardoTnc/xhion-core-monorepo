@startuml XHION

title XHION CORE - Diagrama de Casos de Uso\nPlataforma de Productividad Operativa v2.0 (Optimizado)

' ============================================================================
' CONFIGURACIÓN DE LAYOUT OPTIMIZADO
' ============================================================================
!define LAYOUT top to bottom direction
skinparam packageStyle rectangle
skinparam linetype ortho
left to right direction

' ============================================================================
' ACTORES DEL SISTEMA
' ============================================================================

actor "Usuario\nInvitado" as Invitado <<Usuario>>
actor "Usuario\nAutenticado" as Usuario <<Usuario>>
actor "Miembro de\nProyecto" as Miembro <<Usuario>>
actor "Responsable\nde Proyecto" as Responsable <<Usuario>>
actor "Jefe de\nDepartamento" as Jefe <<Usuario>>
actor "Administrador" as Admin <<Usuario>>
actor "Sistema de\nAuditoría" as SistemaAudit <<Sistema>>
actor "Sistema de\nNotificaciones" as SistemaNotif <<Sistema>>

' ============================================================================
' RELACIONES DE HERENCIA ENTRE ACTORES
' ============================================================================

Usuario <|-- Miembro
Miembro <|-- Responsable
Usuario <|-- Jefe
Usuario <|-- Admin

' ============================================================================
' COLUMNA 1: SEGURIDAD Y USUARIOS
' ============================================================================

together {
  package "Autenticación y Sesiones" #LightBlue {
    usecase "Iniciar Sesión" as UC01
    usecase "Cerrar Sesión" as UC02
    usecase "Refrescar Token" as UC03
    usecase "Gestionar Sesiones" as UC04
    usecase "Cerrar Sesión Remota" as UC05
    usecase "Ver Historial Sesiones" as UC06
    usecase "Validar Credenciales" as UC07
    usecase "Generar JWT" as UC08
  }

  package "Gestión de Usuarios" #LightGreen {
    usecase "Aceptar Invitación" as UC10
    usecase "Completar Registro" as UC11
    usecase "Invitar Usuario" as UC12
    usecase "Completar Registro Admin" as UC13
    usecase "Ver Usuarios" as UC14
    usecase "Editar Usuario" as UC15
    usecase "Activar/Desactivar" as UC16
    usecase "Eliminar Usuario" as UC17
    usecase "Cambiar Rol Usuario" as UC18
    usecase "Ver Stats Invitaciones" as UC19
    usecase "Validar Token Invitación" as UC20
    usecase "Generar Link Invitación" as UC21
  }

  package "Roles y Permisos" #LightYellow {
    usecase "Crear Rol" as UC30
    usecase "Editar Rol" as UC31
    usecase "Eliminar Rol" as UC32
    usecase "Ver Roles" as UC33
    usecase "Asignar Permisos" as UC34
    usecase "Ver Permisos Sistema" as UC35
    usecase "Buscar Permisos" as UC36
    usecase "Ver Usuarios por Rol" as UC37
    usecase "Validar Permisos" as UC38
  }
}

' ============================================================================
' COLUMNA 2: GESTIÓN DE PROYECTOS Y TAREAS
' ============================================================================

together {
  package "Gestión de Proyectos" #LightCoral {
    usecase "Crear Proyecto" as UC50
    usecase "Ver Proyectos" as UC51
    usecase "Ver Detalle Proyecto" as UC52
    usecase "Editar Proyecto" as UC53
    usecase "Archivar Proyecto" as UC54
    usecase "Eliminar Proyecto" as UC55
    usecase "Duplicar Proyecto" as UC56
    usecase "Exportar Datos" as UC57
    usecase "Gestionar Miembros" as UC58
    usecase "Asignar Responsable" as UC59
    usecase "Cambiar Estado" as UC60
    usecase "Ver Stats Proyecto" as UC61
    usecase "Filtrar Proyectos" as UC62
    usecase "Buscar Proyectos" as UC63
  }

  package "Gestión de Tareas" #LightSalmon {
    usecase "Crear Tarea" as UC70
    usecase "Ver Tareas" as UC71
    usecase "Ver Detalle Tarea" as UC72
    usecase "Editar Tarea" as UC73
    usecase "Eliminar Tarea" as UC74
    usecase "Asignar Tarea" as UC75
    usecase "Cambiar Estado Tarea" as UC76
    usecase "Cambiar Prioridad" as UC77
    usecase "Comentar Tarea" as UC78
    usecase "Adjuntar Archivos" as UC79
    usecase "Mover entre Etapas" as UC80
    usecase "Filtrar Tareas" as UC81
    usecase "Buscar Tareas" as UC82
    usecase "Ver Tareas Asignadas" as UC83
    usecase "Ver Kanban" as UC84
    usecase "Exportar Tareas" as UC85
  }

  package "Gestión de Etapas" #Lavender {
    usecase "Crear Etapa" as UC90
    usecase "Ver Etapas" as UC91
    usecase "Editar Etapa" as UC92
    usecase "Eliminar Etapa" as UC93
    usecase "Reordenar Etapas" as UC94
    usecase "Cambiar Estado Etapa" as UC95
    usecase "Ver Progreso Etapa" as UC96
  }
}

' ============================================================================
' COLUMNA 3: ORGANIZACIÓN Y RECURSOS
' ============================================================================

together {
  package "Gestión de Departamentos" #LightPink {
    usecase "Crear Departamento" as UC100
    usecase "Ver Departamentos" as UC101
    usecase "Ver Detalle Depto" as UC102
    usecase "Editar Departamento" as UC103
    usecase "Eliminar Departamento" as UC104
    usecase "Asignar Jefe" as UC105
    usecase "Gestionar Empleados" as UC106
    usecase "Crear Puesto" as UC107
    usecase "Asignar a Puesto" as UC108
    usecase "Ver Organigrama" as UC109
    usecase "Ver Proyectos Depto" as UC110
    usecase "Ver Stats Depto" as UC111
    usecase "Gestionar Contexto" as UC112
  }

  package "Gestión de Presupuestos" #LightCyan {
    usecase "Crear Presup. Depto" as UC120
    usecase "Crear Presup. Proyecto" as UC121
    usecase "Ver Presupuestos" as UC122
    usecase "Editar Presupuesto" as UC123
    usecase "Eliminar Presupuesto" as UC124
    usecase "Aprobar Presupuesto" as UC125
    usecase "Registrar Movimiento" as UC126
    usecase "Ver Historial Mov." as UC127
    usecase "Ver Balance" as UC128
    usecase "Exportar Presupuesto" as UC129
    usecase "Ver Alertas Presup." as UC130
  }

  package "Perfil de Usuario" #LavenderBlush {
    usecase "Ver Perfil" as UC280
    usecase "Editar Perfil" as UC281
    usecase "Cambiar Contraseña" as UC282
    usecase "Actualizar Avatar" as UC283
    usecase "Config. Preferencias" as UC284
    usecase "Ver Actividad Personal" as UC285
    usecase "Ver Proyectos Asig." as UC286
    usecase "Ver Tareas Asig." as UC287
  }
}

' ============================================================================
' COLUMNA 4: CONOCIMIENTO Y DOCUMENTACIÓN
' ============================================================================

together {
  package "Gestión de Conocimiento" #LightGoldenRodYellow {
    usecase "Crear Artículo" as UC140
    usecase "Ver Artículos" as UC141
    usecase "Ver Detalle Artículo" as UC142
    usecase "Editar Artículo" as UC143
    usecase "Eliminar Artículo" as UC144
    usecase "Categorizar Artículo" as UC145
    usecase "Buscar Conocimiento" as UC146
    usecase "Filtrar por Categoría" as UC147
    usecase "Compartir Artículo" as UC148
    usecase "Versionar Artículo" as UC149
  }

  package "Documentos de Proyecto" #Thistle {
    usecase "Crear Doc. Proyecto" as UC160
    usecase "Ver Docs Proyecto" as UC161
    usecase "Editar Doc. Proyecto" as UC162
    usecase "Eliminar Doc. Proyecto" as UC163
    usecase "Categorizar Doc." as UC164
    usecase "Buscar Documentos" as UC165
    usecase "Filtrar por Tipo Doc." as UC166
    usecase "Ver Historial Versiones" as UC167
  }

  package "Ideas e Innovación" #LemonChiffon {
    usecase "Crear Idea" as UC240
    usecase "Ver Ideas" as UC241
    usecase "Votar Idea" as UC242
    usecase "Comentar Idea" as UC243
    usecase "Editar Idea" as UC244
    usecase "Eliminar Idea" as UC245
    usecase "Convertir a Proyecto" as UC246
    usecase "Categorizar Idea" as UC247
    usecase "Filtrar Ideas" as UC248
  }
}

' ============================================================================
' COLUMNA 5: MONITOREO Y ANÁLISIS
' ============================================================================

together {
  package "Dashboard y Estadísticas" #Honeydew {
    usecase "Ver Dashboard" as UC200
    usecase "Ver Stats Generales" as UC201
    usecase "Ver Proyectos Activos" as UC202
    usecase "Ver Tareas Pendientes" as UC203
    usecase "Ver Actividad Reciente" as UC204
    usecase "Ver Gráficos" as UC205
    usecase "Ver Alertas Sistema" as UC206
    usecase "Personalizar Dashboard" as UC207
    usecase "Exportar Reportes" as UC208
  }

  package "Auditoría y Trazabilidad" #MistyRose {
    usecase "Ver Registro Auditoría" as UC180
    usecase "Filtrar Eventos" as UC181
    usecase "Buscar en Auditoría" as UC182
    usecase "Exportar Auditoría" as UC183
    usecase "Ver Detalles Evento" as UC184
    usecase "Ver Audit. por Usuario" as UC185
    usecase "Ver Audit. por Módulo" as UC186
    usecase "Registrar Evento" as UC187
  }

  package "Insights con IA" #PowderBlue {
    usecase "Ver Insights" as UC300
    usecase "Ver Recomendaciones IA" as UC301
    usecase "Analizar Tendencias" as UC302
    usecase "Predecir Retrasos" as UC303
    usecase "Optimizar Recursos" as UC304
    usecase "Generar Reportes Auto" as UC305
    usecase "Analizar Sentimiento" as UC306
  }
}

' ============================================================================
' COLUMNA 6: PLANIFICACIÓN Y CONFIGURACIÓN
' ============================================================================

together {
  package "Calendario y Planificación" #AliceBlue {
    usecase "Ver Calendario" as UC220
    usecase "Ver Eventos" as UC221
    usecase "Crear Evento" as UC222
    usecase "Editar Evento" as UC223
    usecase "Eliminar Evento" as UC224
    usecase "Ver Tareas Calendario" as UC225
    usecase "Ver Hitos Proyecto" as UC226
    usecase "Filtrar por Tipo" as UC227
    usecase "Sincronizar Calendario" as UC228
  }

  package "Configuración del Sistema" #Seashell {
    usecase "Config. Parámetros" as UC260
    usecase "Gestionar Catálogos" as UC261
    usecase "Config. Notificaciones" as UC262
    usecase "Config. Seguridad" as UC263
    usecase "Ver Logs Sistema" as UC264
    usecase "Gestionar Backups" as UC265
    usecase "Config. Integraciones" as UC266
    usecase "Ver Salud Sistema" as UC267
  }
}

' ============================================================================
' RELACIONES DE ACTORES CON CASOS DE USO - AUTENTICACIÓN
' ============================================================================

Invitado --> UC01
Usuario --> UC02
Usuario --> UC03
Usuario --> UC04
Usuario --> UC05
Usuario --> UC06

UC01 ..> UC07 : <<include>>
UC01 ..> UC08 : <<include>>
UC03 ..> UC08 : <<include>>

