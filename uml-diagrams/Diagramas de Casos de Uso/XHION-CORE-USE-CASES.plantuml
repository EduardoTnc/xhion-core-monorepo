  usecase "Ver Kanban de Tareas" as UC84
  usecase "Exportar Tareas" as UC85
}

Miembro --> UC70
Usuario --> UC71
Miembro --> UC72
Miembro --> UC73
Responsable --> UC74
Responsable --> UC75
Miembro --> UC76
Miembro --> UC77
Miembro --> UC78
Miembro --> UC79
Miembro --> UC80
Usuario --> UC81
Usuario --> UC82
Usuario --> UC83
Usuario --> UC84
Responsable --> UC85

UC70 --> SistemaNotif : <<notify>>
UC75 --> SistemaNotif : <<notify>>
UC76 --> SistemaNotif : <<notify>>
UC78 --> SistemaNotif : <<notify>>

