@startuml XHION

title XHION CORE - Diagrama de Casos de Uso\nPlataforma de Productividad Operativa v1.8

' ============================================================================
' ACTORES DEL SISTEMA
' ============================================================================

actor "Usuario Invitado" as Invitado <<Usuario>>
actor "Usuario Autenticado" as Usuario <<Usuario>>
actor "Miembro de Proyecto" as Miembro <<Usuario>>
actor "Responsable de Proyecto" as Responsable <<Usuario>>
actor "Jefe de Departamento" as Jefe <<Usuario>>
actor "Administrador" as Admin <<Usuario>>
actor "Sistema de Auditoría" as SistemaAudit <<Sistema>>
actor "Sistema de Notificaciones" as SistemaNotif <<Sistema>>

' ============================================================================
' RELACIONES DE HERENCIA ENTRE ACTORES
' ============================================================================

Usuario <|-- Miembro
Miembro <|-- Responsable
Usuario <|-- Jefe
Usuario <|-- Admin

' ============================================================================
' MÓDULO 1: AUTENTICACIÓN Y SESIONES
' ============================================================================

package "Autenticación y Sesiones" #LightBlue {
  usecase "Iniciar Sesión" as UC01
  usecase "Cerrar Sesión" as UC02
  usecase "Refrescar Token" as UC03
  usecase "Gestionar Sesiones Activas" as UC04
  usecase "Cerrar Sesión Remota" as UC05
  usecase "Ver Historial de Sesiones" as UC06
  usecase "Validar Credenciales" as UC07
  usecase "Generar JWT" as UC08
}

Invitado --> UC01
Usuario --> UC02
Usuario --> UC03
Usuario --> UC04
Usuario --> UC05
Usuario --> UC06

UC01 ..> UC07 : <<include>>
UC01 ..> UC08 : <<include>>
UC03 ..> UC08 : <<include>>

' ============================================================================
' MÓDULO 2: GESTIÓN DE USUARIOS E INVITACIONES
' ============================================================================

package "Gestión de Usuarios" #LightGreen {
  usecase "Aceptar Invitación" as UC10
  usecase "Completar Registro" as UC11
  usecase "Invitar Usuario" as UC12
  usecase "Completar Registro por Admin" as UC13
  usecase "Ver Usuarios" as UC14
  usecase "Editar Usuario" as UC15
  usecase "Activar/Desactivar Usuario" as UC16
  usecase "Eliminar Usuario" as UC17
  usecase "Cambiar Rol de Usuario" as UC18
  usecase "Ver Estadísticas de Invitaciones" as UC19
  usecase "Validar Token de Invitación" as UC20
  usecase "Generar Enlace de Invitación" as UC21
}

Invitado --> UC10
Invitado --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17
Admin --> UC18
Admin --> UC19

UC10 ..> UC20 : <<include>>
UC11 ..> UC20 : <<include>>
UC12 ..> UC21 : <<include>>
UC13 ..> UC20 : <<include>>

UC15 --> SistemaAudit : <<notify>>
UC16 --> SistemaAudit : <<notify>>
UC17 --> SistemaAudit : <<notify>>
UC18 --> SistemaAudit : <<notify>>

' ============================================================================
' MÓDULO 3: ROLES Y PERMISOS
' ============================================================================

package "Roles y Permisos" #LightYellow {
  usecase "Crear Rol" as UC30
  usecase "Editar Rol" as UC31
  usecase "Eliminar Rol" as UC32
  usecase "Ver Roles" as UC33
  usecase "Asignar Permisos a Rol" as UC34
  usecase "Ver Permisos del Sistema" as UC35
  usecase "Buscar Permisos" as UC36
  usecase "Ver Usuarios por Rol" as UC37
  usecase "Validar Permisos de Usuario" as UC38
}

Admin --> UC30
Admin --> UC31
Admin --> UC32
Admin --> UC33
Admin --> UC34
Admin --> UC35
Admin --> UC36
Admin --> UC37

UC30 --> SistemaAudit : <<notify>>
UC31 --> SistemaAudit : <<notify>>
UC32 --> SistemaAudit : <<notify>>
UC34 --> SistemaAudit : <<notify>>

' ============================================================================
' MÓDULO 4: GESTIÓN DE PROYECTOS
' ============================================================================

package "Gestión de Proyectos" #LightCoral {
  usecase "Crear Proyecto" as UC50
  usecase "Ver Proyectos" as UC51
  usecase "Ver Detalle de Proyecto" as UC52
  usecase "Editar Proyecto" as UC53
  usecase "Archivar Proyecto" as UC54
  usecase "Eliminar Proyecto" as UC55
  usecase "Duplicar Proyecto" as UC56
  usecase "Exportar Datos de Proyecto" as UC57
  usecase "Gestionar Miembros del Proyecto" as UC58
  usecase "Asignar Responsable" as UC59
  usecase "Cambiar Estado de Proyecto" as UC60
  usecase "Ver Estadísticas de Proyecto" as UC61
  usecase "Filtrar Proyectos" as UC62
  usecase "Buscar Proyectos" as UC63
}

Responsable --> UC50
Usuario --> UC51
Miembro --> UC52
Responsable --> UC53
Responsable --> UC54
Admin --> UC55
Responsable --> UC56
Responsable --> UC57
Responsable --> UC58
Responsable --> UC59
Responsable --> UC60
Usuario --> UC61
Usuario --> UC62
Usuario --> UC63

UC50 --> SistemaAudit : <<notify>>
UC53 --> SistemaAudit : <<notify>>
UC54 --> SistemaAudit : <<notify>>
UC55 --> SistemaAudit : <<notify>>
UC58 --> SistemaNotif : <<notify>>
UC59 --> SistemaNotif : <<notify>>

