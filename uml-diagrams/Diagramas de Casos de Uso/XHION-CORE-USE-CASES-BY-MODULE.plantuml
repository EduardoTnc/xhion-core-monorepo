@startuml MODULO-AUTENTICACION
skinparam packageStyle rectangle
skinparam defaultFontSize 11
left to right direction

title XHION CORE - Casos de Uso\nMódulo: Autenticación y Sesiones

actor Invitado as "Usuario\nInvitado"
actor Usuario as "Usuario\nAutenticado"

package "Autenticación y Sesiones" #LightBlue {
  (Iniciar Sesión) as UC01
  (Cerrar Sesión) as UC02
  (Refrescar Token) as UC03
  (Gestionar Sesiones) as UC04
  (Cerrar Sesión Remota) as UC05
  (Ver Historial) as UC06
  (Validar Credenciales) as UC07
  (Generar JWT) as UC08
}

Invitado --> UC01
Usuario --> UC02
Usuario --> UC03
Usuario --> UC04
Usuario --> UC05
Usuario --> UC06

UC01 ..> UC07 : <<include>>
UC01 ..> UC08 : <<include>>
UC03 ..> UC08 : <<include>>

note bottom of UC01
  JWT (15 min) + Refresh (7 días)
end note

@enduml

